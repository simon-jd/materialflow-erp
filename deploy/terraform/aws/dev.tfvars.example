# Copy to dev.tfvars (git-ignored) and fill in the account. Every value below is billable:
# see the cost table in docs/runbooks/aws-deploy.md before applying.

# Explicit acknowledgement; plans fail without it.
enable_aws = true

aws_account_id = "123456789012"
aws_region     = "us-east-1"
environment    = "dev"

# Leave unset for the first apply. After the cd-aws workflow (run with images_only) has pushed
# images, set it to that commit SHA and apply again to create the ECS services.
# bootstrap_image_tag = "0123456789abcdef0123456789abcdef01234567"

# Cost and availability trade-offs (defaults shown).
# single_nat_gateway         = true
# enable_interface_endpoints = false
# postgres_multi_az          = false
# container_insights         = "disabled"

# Teardown: set to false and apply before `terraform destroy` (see the runbook).
# postgres_deletion_protection = true
# postgres_skip_final_snapshot = false

# Set false if the account already has a GitHub Actions OIDC provider.
# create_github_oidc_provider = true
