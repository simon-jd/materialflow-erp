# Copy to backend.hcl (git-ignored) and run:
#   terraform init -backend-config=backend.hcl
#
# The state bucket is created once, outside this configuration, so destroying the environment
# never deletes its own state. See "Bootstrap" in docs/runbooks/aws-deploy.md:
#   aws s3api create-bucket --bucket <bucket> --region us-east-1
#   aws s3api put-bucket-versioning --bucket <bucket> --versioning-configuration Status=Enabled
#   aws s3api put-public-access-block --bucket <bucket> --public-access-block-configuration \
#     BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true
#
# bucket       = "materialflow-tfstate-123456789012"
# key          = "aws/dev/terraform.tfstate"
# region       = "us-east-1"
# encrypt      = true
# use_lockfile = true   # S3-native state locking (Terraform >= 1.10); no DynamoDB table needed
