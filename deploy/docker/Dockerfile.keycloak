# syntax=docker/dockerfile:1.7
# Keycloak for the AWS environment: an optimized production build with the repository realm
# baked in (build from the repository root). Keep the version equal to deploy/compose/compose.yml.
ARG KEYCLOAK_VERSION=26.3.3

# The shared realm only lists localhost redirect URIs; add the public ones (see the jq filter).
FROM alpine:3.22 AS realm
RUN apk add --no-cache jq
COPY deploy/docker/keycloak-realm-aws.jq deploy/compose/keycloak/materialflow-realm.json /in/
RUN jq -f /in/keycloak-realm-aws.jq /in/materialflow-realm.json > /materialflow-realm.json

FROM quay.io/keycloak/keycloak:${KEYCLOAK_VERSION} AS builder
# Build-time options: PostgreSQL, health endpoints on the management port (9000), every public
# path under /idp (one CloudFront behavior that cannot collide with console routes such as
# /auth/callback), and a single-node local cache.
ENV KC_DB=postgres \
    KC_HEALTH_ENABLED=true \
    KC_HTTP_RELATIVE_PATH=/idp \
    KC_HTTP_MANAGEMENT_RELATIVE_PATH=/ \
    KC_CACHE=local
RUN /opt/keycloak/bin/kc.sh build

FROM quay.io/keycloak/keycloak:${KEYCLOAK_VERSION}
COPY --from=builder /opt/keycloak/ /opt/keycloak/
COPY --from=realm /materialflow-realm.json /opt/keycloak/data/import/materialflow-realm.json
ENV KC_HTTP_MANAGEMENT_RELATIVE_PATH=/
ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]
# --import-realm skips a realm that already exists, so restarts keep runtime changes.
CMD ["start", "--optimized", "--import-realm"]
